# Copy to .env.local for local dev (gitignored). Also set these as Vercel
# project env vars so the deployed instance has stable, known logins
# instead of a fresh random password generated per server start.
SEED_ADMIN_PASSWORD=
SEED_BRANCH_PASSWORD=
SEED_TECH_PASSWORD=

# Optional — enables the street-address autocomplete on the request form.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional — enables web push notifications to logged-in admins (new Home
# Service Requests, technician status updates). Generate a pair with
# `npx web-push generate-vapid-keys` and set the same pair in every
# environment (dev + prod) — a mismatched key invalidates existing browser
# subscriptions.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional — enables SMS alerts to admins with a phone number set (Admin >
# Users) for the same events as web push. Requires a Semaphore
# (semaphore.co) account; already used for customer-facing SMS.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Required — enables the public ₱10 iCloud Status Checker (PayMongo
# GCash + card via hosted Checkout Sessions). Requires a PayMongo account.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# From the PayMongo Dashboard's webhook config for the
# app/api/webhooks/paymongo endpoint — required to verify inbound webhook
# signatures. Never processes an unsigned payload without it.
PAYMONGO_WEBHOOK_SECRET=

# Required — enables the SICKW.com "iCloud ON/OFF" check called after
# payment. SICKW_SERVICE_ID currently falls back to a placeholder in
# lib/sickw.ts that MUST be corrected before launch — see the TODO block
# at the top of that file — once the real API docs are confirmed against
# the SICKW dashboard's API Access tab.
SICKW_API_KEY=
SICKW_SERVICE_ID=
