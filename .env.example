# Copy to .env.local for local dev (gitignored). Also set these as Vercel
# project env vars so the deployed instance has stable, known logins
# instead of a fresh random password generated per server start.
SEED_ADMIN_PASSWORD=
SEED_BRANCH_PASSWORD=
SEED_TECH_PASSWORD=

# Supabase Postgres connection. From your Supabase project: Settings ->
# Database -> Connection string.
# - POSTGRES_URL: the pooled (pgbouncer, port 6543) connection string —
#   used by the app at runtime (lib/db.ts).
# - POSTGRES_URL_NON_POOLING: the direct (port 5432) connection string —
#   used only by scripts/seed.cjs and for running migrations, since
#   pgbouncer's transaction pooling mode doesn't support prepared
#   statements / multi-statement transactions reliably.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Optional — enables the street-address autocomplete on the request form.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
